{
  "name": "masu-workbook",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "node scripts/pages.mjs && tsc --noEmit && vite build",
    "test": "node --experimental-strip-types --test tests/engine.test.mjs tests/i18n.test.mjs tests/report.test.mjs",
    "lint": "eslint src tests scripts/*.mjs public/language.js",
    "test:e2e": "node --experimental-strip-types tests/browser.mjs",
    "bundle": "npm run build && bash scripts/bundle.sh",
    "test:division": "node --experimental-strip-types tests/division-browser.mjs",
    "test:decimal": "node --experimental-strip-types tests/decimal-browser.mjs",
    "test:lan": "node --experimental-strip-types tests/lan-browser.mjs",
    "test:arithmetic": "node --experimental-strip-types tests/arithmetic-browser.mjs",
    "test:licenses": "node --test tests/licenses.test.mjs",
    "test:publication": "node tests/publication-browser.mjs",
    "test:i18n": "node --experimental-strip-types tests/language-browser.mjs",
    "test:report": "node --experimental-strip-types tests/report-browser.mjs"
  },
  "dependencies": {
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@typescript-eslint/parser": "8.73.0",
    "eslint": "9.39.5",
    "playwright-core": "1.61.1",
    "prettier": "3.8.2",
    "typescript": "5.9.3",
    "vite": "7.3.8"
  },
  "license": "SEE LICENSE IN LICENSE"
}
